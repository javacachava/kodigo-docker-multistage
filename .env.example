# =============================================================================
# Variables del ecosistema Docker. Copia este archivo a .env antes de levantar:
#   cp .env.example .env
#
# Los valores de abajo son SOLO para demostración local. Antes de usar el
# ecosistema fuera de tu máquina reemplaza todas las contraseñas y claves.
# =============================================================================

# ----- Puertos publicados en el host (MySQL no se publica nunca) ---------------
FRONTEND_PORT=3000
API_PORT=8000

# ----- MySQL -------------------------------------------------------------------
# Imagen oficial. 8.0 es la versión pedida; 8.4 (LTS) es la recomendada hoy,
# porque 8.0 ya terminó su soporte. Ambas funcionan sin más cambios.
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=ecommerce_api
MYSQL_USER=ecommerce
MYSQL_PASSWORD=change_me_app_password

# ----- Laravel (backend) -------------------------------------------------------
APP_NAME="Ecommerce API"
APP_ENV=production
APP_DEBUG=false
# URL pública de la API tal como la ve el navegador (se usa en Swagger).
APP_URL=http://localhost:8000
# Clave de cifrado de Laravel. Regenerar: echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:40TXr0lX2Huvf8AwUTa0s/u5jS8s5Vgw+w9amVgAwAU=
# Secreto de firma de los JWT. Regenerar: openssl rand -hex 32
JWT_SECRET=e077668fb5e86314b2bd9a4aa7923c1ae5490b1a4970cc03e256807406d461fd
JWT_TTL=60
LOG_LEVEL=warning

# Ejecutar migraciones al arrancar el backend (true/false).
RUN_MIGRATIONS=true
# Cargar datos de demo (admin@example.com / cliente@example.com, clave
# Password123, y ~20 productos) solo si la tabla de usuarios está vacía.
# Ponlo en false en cualquier entorno real.
RUN_SEEDERS=true

# ----- Stripe (opcional) -------------------------------------------------------
# Con valores de marcador la API opera en modo simulación (no llama a Stripe).
STRIPE_KEY=pk_test_tu_clave_publicable_aqui
STRIPE_SECRET=sk_test_tu_clave_secreta_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_signing_secret_aqui
STRIPE_CURRENCY=usd
